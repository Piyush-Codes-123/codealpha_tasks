import tkinter as tk
from tkinter import messagebox
import random


# ==============================
# GAME DATA
# ==============================

WORDS = [
    "python",
    "computer",
    "programming",
    "keyboard",
    "developer",
    "internet",
    "software",
    "database",
    "algorithm",
    "technology"
]

MAX_WRONG = 6


class HangmanGame:

    def __init__(self, root):

        self.root = root

        self.root.title("Hangman Challenge")
        self.root.geometry("900x650")
        self.root.resizable(False, False)
        self.root.configure(bg="#0f172a")

        self.word = ""
        self.guessed_letters = set()
        self.wrong_guesses = 0
        self.game_over = False

        self.create_ui()
        self.new_game()

    # ==============================
    # UI
    # ==============================

    def create_ui(self):

        # Header
        header = tk.Frame(
            self.root,
            bg="#111827",
            height=90
        )
        header.pack(fill="x")

        title = tk.Label(
            header,
            text="HANGMAN",
            font=("Segoe UI", 28, "bold"),
            fg="#38bdf8",
            bg="#111827"
        )
        title.pack(pady=(15, 0))

        subtitle = tk.Label(
            header,
            text="CodeAlpha Python Internship • Task 1",
            font=("Segoe UI", 10),
            fg="#94a3b8",
            bg="#111827"
        )
        subtitle.pack()

        # Main area
        main = tk.Frame(
            self.root,
            bg="#0f172a"
        )
        main.pack(fill="both", expand=True, padx=35, pady=25)

        # Left game panel
        game_panel = tk.Frame(
            main,
            bg="#1e293b",
            width=520
        )
        game_panel.pack(
            side="left",
            fill="both",
            expand=True,
            padx=(0, 15)
        )

        # Right panel
        side_panel = tk.Frame(
            main,
            bg="#1e293b",
            width=260
        )
        side_panel.pack(
            side="right",
            fill="y"
        )

        # Canvas
        self.canvas = tk.Canvas(
            game_panel,
            width=480,
            height=300,
            bg="#1e293b",
            highlightthickness=0
        )
        self.canvas.pack(pady=25)

        # Word
        self.word_label = tk.Label(
            game_panel,
            text="",
            font=("Consolas", 28, "bold"),
            fg="#f8fafc",
            bg="#1e293b"
        )
        self.word_label.pack(pady=10)

        # Message
        self.message_label = tk.Label(
            game_panel,
            text="Guess the hidden word!",
            font=("Segoe UI", 12),
            fg="#94a3b8",
            bg="#1e293b"
        )
        self.message_label.pack()

        # Input area
        input_frame = tk.Frame(
            game_panel,
            bg="#1e293b"
        )
        input_frame.pack(pady=20)

        self.entry = tk.Entry(
            input_frame,
            font=("Segoe UI", 18, "bold"),
            width=5,
            justify="center",
            bg="#0f172a",
            fg="white",
            insertbackground="white",
            relief="flat"
        )
        self.entry.pack(
            side="left",
            padx=8
        )

        self.guess_button = tk.Button(
            input_frame,
            text="GUESS",
            font=("Segoe UI", 11, "bold"),
            bg="#0284c7",
            fg="white",
            activebackground="#0369a1",
            activeforeground="white",
            relief="flat",
            width=12,
            height=2,
            cursor="hand2",
            command=self.make_guess
        )
        self.guess_button.pack(side="left")

        self.entry.bind(
            "<Return>",
            lambda event: self.make_guess()
        )

        # ==============================
        # SIDE PANEL
        # ==============================

        tk.Label(
            side_panel,
            text="GAME STATUS",
            font=("Segoe UI", 12, "bold"),
            fg="#38bdf8",
            bg="#1e293b"
        ).pack(pady=(25, 20))

        self.status_label = tk.Label(
            side_panel,
            text="READY",
            font=("Segoe UI", 18, "bold"),
            fg="#22c55e",
            bg="#1e293b"
        )
        self.status_label.pack()

        # Wrong guesses
        tk.Label(
            side_panel,
            text="Wrong Guesses",
            font=("Segoe UI", 10),
            fg="#94a3b8",
            bg="#1e293b"
        ).pack(pady=(30, 5))

        self.wrong_label = tk.Label(
            side_panel,
            text="0 / 6",
            font=("Segoe UI", 22, "bold"),
            fg="#f87171",
            bg="#1e293b"
        )
        self.wrong_label.pack()

        # Guessed letters
        tk.Label(
            side_panel,
            text="Guessed Letters",
            font=("Segoe UI", 10),
            fg="#94a3b8",
            bg="#1e293b"
        ).pack(pady=(30, 5))

        self.guessed_label = tk.Label(
            side_panel,
            text="None",
            font=("Segoe UI", 11, "bold"),
            fg="#f8fafc",
            bg="#1e293b",
            wraplength=190
        )
        self.guessed_label.pack()

        # New game button
        new_button = tk.Button(
            side_panel,
            text="NEW GAME",
            font=("Segoe UI", 11, "bold"),
            bg="#22c55e",
            fg="#052e16",
            activebackground="#16a34a",
            relief="flat",
            width=18,
            height=2,
            cursor="hand2",
            command=self.new_game
        )
        new_button.pack(
            pady=(45, 10)
        )

        # Exit button
        exit_button = tk.Button(
            side_panel,
            text="EXIT",
            font=("Segoe UI", 10, "bold"),
            bg="#334155",
            fg="white",
            activebackground="#475569",
            relief="flat",
            width=18,
            height=2,
            cursor="hand2",
            command=self.root.destroy
        )
        exit_button.pack()

    # ==============================
    # NEW GAME
    # ==============================

    def new_game(self):

        self.word = random.choice(WORDS)

        self.guessed_letters = set()

        self.wrong_guesses = 0

        self.game_over = False

        self.entry.config(
            state="normal"
        )

        self.guess_button.config(
            state="normal"
        )

        self.status_label.config(
            text="PLAYING",
            fg="#22c55e"
        )

        self.message_label.config(
            text="Guess the hidden word!"
        )

        self.wrong_label.config(
            text="0 / 6"
        )

        self.guessed_label.config(
            text="None"
        )

        self.entry.delete(
            0,
            tk.END
        )

        self.draw_hangman()

        self.update_word()

        self.entry.focus()

    # ==============================
    # WORD DISPLAY
    # ==============================

    def update_word(self):

        display = ""

        for letter in self.word:

            if letter in self.guessed_letters:
                display += letter.upper() + " "

            else:
                display += "_ "

        self.word_label.config(
            text=display.strip()
        )

    # ==============================
    # GUESS
    # ==============================

    def make_guess(self):

        if self.game_over:
            return

        letter = self.entry.get().lower().strip()

        self.entry.delete(
            0,
            tk.END
        )

        if len(letter) != 1 or not letter.isalpha():

            messagebox.showwarning(
                "Invalid Input",
                "Please enter exactly one letter."
            )

            return

        if letter in self.guessed_letters:

            messagebox.showinfo(
                "Already Used",
                "You already guessed this letter."
            )

            return

        self.guessed_letters.add(letter)

        if letter not in self.word:

            self.wrong_guesses += 1

            self.wrong_label.config(
                text=f"{self.wrong_guesses} / {MAX_WRONG}"
            )

            self.message_label.config(
                text=f"'{letter.upper()}' is not in the word.",
                fg="#f87171"
            )

        else:

            self.message_label.config(
                text=f"Good guess! '{letter.upper()}' is correct.",
                fg="#4ade80"
            )

        self.update_guessed()

        self.update_word()

        self.draw_hangman()

        self.check_game()

    # ==============================
    # GUESSED LETTERS
    # ==============================

    def update_guessed(self):

        if self.guessed_letters:

            letters = sorted(
                self.guessed_letters
            )

            self.guessed_label.config(
                text="  ".join(
                    letter.upper()
                    for letter in letters
                )
            )

    # ==============================
    # CHECK GAME
    # ==============================

    def check_game(self):

        if all(
            letter in self.guessed_letters
            for letter in self.word
        ):

            self.game_over = True

            self.status_label.config(
                text="YOU WON!",
                fg="#4ade80"
            )

            self.message_label.config(
                text=f"Excellent! The word was {self.word.upper()}",
                fg="#4ade80"
            )

            self.entry.config(
                state="disabled"
            )

            self.guess_button.config(
                state="disabled"
            )

            return

        if self.wrong_guesses >= MAX_WRONG:

            self.game_over = True

            self.status_label.config(
                text="GAME OVER",
                fg="#f87171"
            )

            self.message_label.config(
                text=f"The word was {self.word.upper()}",
                fg="#f87171"
            )

            self.word_label.config(
                text=" ".join(
                    letter.upper()
                    for letter in self.word
                )
            )

            self.entry.config(
                state="disabled"
            )

            self.guess_button.config(
                state="disabled"
            )

    # ==============================
    # HANGMAN DRAWING
    # ==============================

    def draw_hangman(self):

        self.canvas.delete("all")

        # Ground
        self.canvas.create_line(
            80, 270,
            400, 270,
            fill="#64748b",
            width=5
        )

        # Pole
        self.canvas.create_line(
            130, 270,
            130, 50,
            fill="#64748b",
            width=5
        )

        # Top
        self.canvas.create_line(
            130, 50,
            300, 50,
            fill="#64748b",
            width=5
        )

        # Rope
        self.canvas.create_line(
            300, 50,
            300, 85,
            fill="#64748b",
            width=4
        )

        parts = self.wrong_guesses

        if parts >= 1:

            self.canvas.create_oval(
                265, 85,
                335, 155,
                outline="#38bdf8",
                width=5
            )

        if parts >= 2:

            self.canvas.create_line(
                300, 155,
                300, 220,
                fill="#38bdf8",
                width=5
            )

        if parts >= 3:

            self.canvas.create_line(
                300, 170,
                255, 205,
                fill="#38bdf8",
                width=5
            )

        if parts >= 4:

            self.canvas.create_line(
                300, 170,
                345, 205,
                fill="#38bdf8",
                width=5
            )

        if parts >= 5:

            self.canvas.create_line(
                300, 220,
                260, 255,
                fill="#38bdf8",
                width=5
            )

        if parts >= 6:

            self.canvas.create_line(
                300, 220,
                340, 255,
                fill="#38bdf8",
                width=5
            )


# ==============================
# MAIN
# ==============================

if __name__ == "__main__":

    root = tk.Tk()

    game = HangmanGame(root)

    root.mainloop()